{
  "name": "dsh-meow-push",
  "version": "1.0.0",
  "private": true,
  "description": "MeoW push tools for DeepSeek Harness: send text or HTML notifications to a registered MeoW nickname through api.chuckfang.com.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./internals": "./lib/internals.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "references/**",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  },
  "license": "MIT"
}
